# Production configuration. Copy to .env.prod (never commit it) — `make secrets` fills the secrets for you.

# Public host name (DNS A/AAAA record pointing to this server).
DOMAIN=mama.example.com

# The stack serves plain HTTP on this host address/port: a reverse proxy on the host terminates TLS
# for DOMAIN and forwards to it. Keep HTTP_BIND on the loopback unless the proxy runs elsewhere.
HTTP_BIND=127.0.0.1
HTTP_PORT=8090

# --- Secrets (generated by `make secrets`) ---
APP_SECRET=
JWT_PASSPHRASE=
MERCURE_JWT_SECRET=
DB_PASSWORD=
REDIS_PASSWORD=

# Browsers allowed to call the API (the mobile app does not use CORS).
CORS_ALLOW_ORIGIN=^https://mama\.example\.com$

# Image tag deployed by CI (written by scripts/deploy.sh; `latest` when empty).
IMAGE_TAG=latest

# Host paths
BACKUP_DIR=./backups
