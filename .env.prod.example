# Production configuration. Copy to .env.prod (never commit it) — `make secrets` fills the secrets for you.

# Public host name (DNS A/AAAA record pointing to this server) and contact e-mail for Let's Encrypt.
DOMAIN=mama.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Host ports of the edge nginx.
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets (generated by `make secrets`) ---
APP_SECRET=
JWT_PASSPHRASE=
MERCURE_JWT_SECRET=
DB_PASSWORD=
REDIS_PASSWORD=

# Browsers allowed to call the API (the mobile app does not use CORS).
CORS_ALLOW_ORIGIN=^https://mama\.example\.com$

# Docker volume / host paths
LETSENCRYPT_DIR=/etc/letsencrypt
BACKUP_DIR=./backups
